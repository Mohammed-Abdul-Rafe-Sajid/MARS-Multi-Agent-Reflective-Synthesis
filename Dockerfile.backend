# ============================================================================
# Dockerfile.backend - Production-Ready FastAPI Backend Container
# ============================================================================
# Multi-stage build for optimized production deployment
# Python 3.11-slim for minimal footprint with security updates
# ============================================================================

# ──────────────────────────────────────────────────────────────────────────
# STAGE 1: Builder - Install Python dependencies
# ──────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim as builder

WORKDIR /build

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Copy requirements file
COPY backend/requirements.txt .

# Install Python dependencies to user site-packages
# This approach avoids venv complexity and reduces image size
RUN pip install --user --no-warn-script-location \
    -r requirements.txt


# ──────────────────────────────────────────────────────────────────────────
# STAGE 2: Runtime - Final production image
# ──────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Set environment variables for production
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/root/.local/bin:$PATH \
    PYTHONPATH=/app:$PYTHONPATH

# Install runtime system dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder stage
COPY --from=builder /root/.local /root/.local

# Copy backend source code
COPY backend/ .

# Create directories for data persistence (volumes will mount here)
RUN mkdir -p /app/chromadb_store \
    && mkdir -p /app/data \
    && mkdir -p /app/logs

# Health check - ensures container is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port for FastAPI application
EXPOSE 8000

# Run FastAPI with Uvicorn in production mode
# - host 0.0.0.0: accessible from outside container
# - workers 4: parallel request handling (adjust based on CPU cores)
# - no-reload: production setting (no auto-restart on file changes)
# - log-level info: standard logging for production
CMD ["python", "-m", "uvicorn", \
     "main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4", \
     "--log-level", "info"]

# ============================================================================
# NOTES:
# ─────
# 1. Multi-stage build reduces image size:
#    • Builder stage (compiler, build tools) is discarded
#    • Final image: ~350MB (vs ~1.5GB with build tools)
#
# 2. Python 3.11-slim: Minimal base image
#    • Only essentials included
#    • Smaller attack surface than full Python image
#
# 3. Environment variables:
#    • PYTHONUNBUFFERED: Immediate output (better logging)
#    • PYTHONDONTWRITEBYTECODE: No .pyc files (slower startup avoided)
#
# 4. Health check: Docker monitors container health
#    • Required for Docker Compose restart policies
#    • Critical for Kubernetes deployments
#
# 5. Volume mounts at runtime:
#    • /app/chromadb_store → chromadb_store volume
#    • /app/data → database-data volume
#    • /app/logs → logs volume
#    • Configured in docker-compose.yml
#
# 6. Security - .env NOT copied:
#    • Environment variables passed at runtime
#    • Prevents credential exposure in image layers
#    • Secrets managed via docker-compose or Kubernetes
#
# 7. Uvicorn workers:
#    • 4 workers = 4 concurrent requests
#    • Adjust based on deployment CPU cores
#    • In docker-compose: likely 1-2 cores available per container
# ============================================================================
