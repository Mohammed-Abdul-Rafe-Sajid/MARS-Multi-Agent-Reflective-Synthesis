{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfile": "Dockerfile.backend"
  },
  "deploy": {
    "startCommand": "python -m uvicorn main:app --host 0.0.0.0 --port $PORT --workers 1 --log-level info",
    "restartPolicyCondition": "on-failure",
    "restartPolicyMaxRetryCount": 5
  }
}
