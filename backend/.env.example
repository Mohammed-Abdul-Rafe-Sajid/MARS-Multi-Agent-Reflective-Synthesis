# ── Required ──────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_actual_api_key_here   # Get from https://platform.openai.com/api-keys

# ── LLM ───────────────────────────────────────────────────
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# ── Retrieval (Section 0.7) ────────────────────────────────
MAX_PAPERS_PER_QUERY=15
TOP_K_RAG_CHUNKS=5
PAPER_AGE_CUTOFF_YEARS=10
RAG_SIMILARITY_THRESHOLD=0.60
DEFAULT_ABLATION_MODE=both          # api_only | rag_only | both

# ── Reflection Engine (Section 0.5 / 0.8) ─────────────────
MAX_ITERATIONS=4
CLAIM_DELTA_THRESHOLD=0.10          # convergence: < 10% claims modified
WEAK_CLAIM_RATIO_THRESHOLD=0.30     # triggers rewrite_synthesis / retrieve_evidence

# ── Verifier (Section 0.4) ────────────────────────────────
SIMILARITY_VERIFIED_THRESHOLD=0.75
SIMILARITY_WEAK_THRESHOLD=0.60
MIN_SUPPORTING_PAPERS=2

# ── RAG / ChromaDB ────────────────────────────────────────
CHROMA_PERSIST_DIR=./chromadb_store
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_MODEL=text-embedding-3-small

# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./research_system.db

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
