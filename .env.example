# .env.example
# Copy this to .env and fill in your actual values
# NEVER commit .env to git

# ============================================================
# OpenAI Configuration
# ============================================================
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# ============================================================
# LLM Settings
# ============================================================
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# ============================================================
# Retrieval Settings (arXiv + ChromaDB RAG)
# ============================================================
MAX_PAPERS_PER_QUERY=15
TOP_K_RAG_CHUNKS=5
PAPER_AGE_CUTOFF_YEARS=10
RAG_SIMILARITY_THRESHOLD=0.60
DEFAULT_ABLATION_MODE=both

# ============================================================
# Reflection Engine Configuration
# ============================================================
MAX_ITERATIONS=4
CLAIM_DELTA_THRESHOLD=0.10
WEAK_CLAIM_RATIO_THRESHOLD=0.30

# ============================================================
# Verifier Thresholds
# ============================================================
SIMILARITY_VERIFIED_THRESHOLD=0.75
SIMILARITY_WEAK_THRESHOLD=0.60
MIN_SUPPORTING_PAPERS=2

# ============================================================
# Embeddings & Vector Store Chunking
# ============================================================
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Database Configuration
# ============================================================
# SQLite path (automatically set to /app/data/research_system.db in Docker)
# Leave as-is for Docker deployments
# For local development: sqlite:///./research_system.db

# ============================================================
# Server Configuration
# ============================================================
# For Docker: always 0.0.0.0:8000
# For local development: modify in config.py if needed
